#!/bin/sh
# The gate that would have kept CI green for two days (2026-07-15).
#
# On 2026-07-13 five lint errors of mine reached main; the CI runs Lint BEFORE
# the tests, so EVERY job on every OS failed and the build was skipped — for
# two days the public repo looked broken while the site claimed "6,864
# passing". I did not run ruff before committing. Good intentions are not a
# mechanism; this is.
#
# 2026-07-30: this hook had stopped being one. It ran
#
#     ruff check engram tests scripts
#
# under a comment claiming "exactly what ci.yml runs", while ci.yml had moved to
# `verimem` at the rename. `engram/` is now an 88-line compatibility shim and
# `verimem/` is 107,067 lines, so the gate covered 0.08% of the code — and it
# never failed, which is exactly why nobody noticed. A gate that cannot fail is
# not a gate, it is a green light.
#
# So it no longer keeps its own copy of the list: it READS the ruff line out of
# the workflow. A duplicated list drifts the moment one side moves; a derived
# one cannot.
#
# Install once:  git config core.hooksPath .githooks
# Bypass (rare): git commit --no-verify

set -e

if ! command -v ruff >/dev/null 2>&1; then
    echo "pre-commit: ruff not found — skipping lint gate (pip install ruff)"
    exit 0
fi

WF=".github/workflows/ci.yml"
TARGETS=""
if [ -f "$WF" ]; then
    # the argument list of the workflow's own `ruff check ...` step
    TARGETS=$(grep -oE 'ruff check [A-Za-z0-9_ /.-]+' "$WF" | head -1 | sed 's/^ruff check //')
fi

if [ -z "$TARGETS" ]; then
    # The workflow is the source of truth. If it cannot be read, SAY so instead
    # of quietly checking a guess — the silent-wrong-target failure this hook
    # was just repaired for.
    echo "pre-commit: cannot read the ruff targets from $WF — using the default"
    TARGETS="verimem tests scripts"
fi

if ! ruff check $TARGETS; then
    echo ""
    echo "pre-commit BLOCKED: ruff would fail the CI's Lint step, which runs"
    echo "before the tests — every job on every OS would go red."
    echo "Fix:  ruff check $TARGETS --fix"
    exit 1
fi

# --- il cancello del publish, sulle sole righe che stai AGGIUNGENDO ---------
#
# 2026-08-28: il veto di `publish.yml` (scripts/controlla_registro.py) e' un
# VETO DI RILASCIO — `return 1` ferma il job — e nessuno se ne accorge finche'
# non si costruisce il pacchetto. Misurato quel giorno: 7 identificativi alle
# 20:00, 12 alle 22:35 dopo UN file nuovo, 6 alle 22:58 dopo due cure. Il
# cancello si richiudeva da solo mentre si lavorava, perche' questo hook girava
# `ruff` e non il veto.
#
# ⚠️ GUARDA SOLO LE RIGHE AGGIUNTE, di proposito. Il debito che c'e' gia' non
# e' colpa di chi commetta adesso, e bloccarlo fermerebbe tutti su un lavoro
# altrui: e' esattamente il blocco che ha fermato il repo stamattina. Cosi'
# invece nessuno e' fermato oggi e nessuno puo' PEGGIORARE il conto domani.
#
# Il pattern si DERIVA da controlla_registro.py, come i target di ruff si
# derivano da ci.yml: una lista duplicata divergerebbe alla prima modifica.
# ⚠️ Limite dichiarato: `\b` non e' ERE POSIX, e' un'estensione GNU. Su un grep
# non-GNU l'estrazione fallisce e il blocco NON scatta — degrada in silenzio,
# quindi qui sotto lo dice.
REG="scripts/controlla_registro.py"
if [ -f "$REG" ]; then
    PAT=$(grep -oE '"identificativo di sessione": \(re\.compile\(r"[^"]+"' "$REG" \
          | grep -oE '\(r"[^"]+"' | sed 's/^(r"//; s/"$//')
    if [ -z "$PAT" ]; then
        echo "pre-commit: non riesco a leggere il pattern da $REG — veto NON applicato"
    else
        NUOVE=$(git diff --cached -U0 -- 'verimem/*.py' \
                | grep -E '^\+' | grep -vE '^\+\+\+' | grep -cE "$PAT" || true)
        if [ "${NUOVE:-0}" -gt 0 ]; then
            echo ""
            echo "pre-commit BLOCKED: $NUOVE riga/e che stai aggiungendo a verimem/"
            echo "contengono un identificativo di sessione ($PAT)."
            echo "Quel pacchetto e' cio' che si spedisce, e il veto del publish"
            echo "(publish.yml:218) FERMA il job di rilascio su questo."
            echo ""
            git diff --cached -U0 -- 'verimem/*.py' | grep -E '^\+' \
                | grep -vE '^\+\+\+' | grep -E "$PAT" | head -5 | sed 's/^/    /'
            echo ""
            echo "Riscrivi la frase senza la sigla (la misura e la data si tengono),"
            echo "oppure  git commit --no-verify  se sai perche'."
            exit 1
        fi
    fi
fi

echo "pre-commit: lint clean ($TARGETS)"
