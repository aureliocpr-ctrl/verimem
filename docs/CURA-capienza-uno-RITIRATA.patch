+#: Una DATA ISO completa. ``YEAR_RE`` esclude gia' l'anno nudo; il mese e il
+#: giorno no, e «Il report del 2026-08-04 conta 42 righe» produceva ('', 8.0) e
+#: ('conta', 4.0). Due report di due giorni diversi avevano quindi «conta 4» e
+#: «conta 5» — stessa unita', valori diversi — ed e' la forma che scriviamo piu'
+#: spesso.
+_DATA_ISO_RE = re.compile(r"\b\d{4}-\d{2}-\d{2}\b")
+
+#: Un IDENTIFICATORE: lettere attaccate a un trattino e a delle cifre.
+#:
+#: PERCHE' (2026-08-04, dal referto di ws5 sulla scala — «duecento record
+#: scritti, uno vivo: il corpus ha capienza UNO»). Il codice di un record veniva
+#: letto come una QUANTITA', e la parola successiva come la sua unita':
+#:
+#:   «Il campione S-001 contiene piombo a 11 mg/l»  ->  ('contiene', 1.0) …
+#:   «Il campione S-002 contiene cadmio a 12 mg/l»  ->  ('contiene', 2.0) …
+#:   numeric_conflict  ->  ('contiene', 1.0, 2.0)
+#:
+#: Due schede con codici diversi risultavano «la stessa grandezza con due
+#: valori», cioe' una contraddizione: **l'identificatore che DISTINGUE i due
+#: record diventava la prova che si contraddicono**. Moltiplicato per un
+#: registro, lascia un fatto vivo su venticinque (misurato).
+#:
+#: Sul corpus vivo sono 908 fatti su 6109 (15%), e i piu' frequenti non sono
+#: codici di laboratorio ma i nomi che usiamo ogni giorno: `glm-5`, `GPT-5`,
+#: `gemini-2`, `opus-4`, `round-2`, `top-10`.
+#:
+#: ⚠️ QUESTA CURA NON E' QUELLA GIA' CADUTA: non conserva token corti e cifre in
+#: `content_tokens` (falsificato, coppie sopra soglia da 848 a 2293), non alza
+#: soglie (margine +0.000), non e' il veto sulle entita'. Toglie un falso
+#: positivo alla radice — un codice non e' una misura, e non lo era nemmeno
+#: prima.
+_IDENTIFICATORE_RE = re.compile(r"\b[A-Za-z]{1,6}-\d{1,6}\b")
+
+
+def _senza_identificatori(text: str) -> str:
+    """Il testo con date e codici sostituiti da spazi.
+
+    Spazi e non stringa vuota: le posizioni restano quelle originali, cosi' ogni
+    lettore che ragioni per offset non si sposta.
+    """
+    def _bianco(m: re.Match) -> str:
+        return " " * (m.end() - m.start())
+    return _IDENTIFICATORE_RE.sub(_bianco, _DATA_ISO_RE.sub(_bianco, text or ""))
+
